APP_NAME=TechMizane
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:pVDmvuxhw4O1Wbrvxv0iCB27ONZGJybAltivS44cUHo=
APP_URL=http://localhost

# Use the same PostgreSQL instance that runs in Docker Compose.
# RefreshDatabase wraps every test in a transaction that rolls back,
# so tests are isolated without needing a separate test database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=techmizane
DB_USERNAME=techmizane
DB_PASSWORD=secret

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

BCRYPT_ROUNDS=4
