# Use an isolated PostgreSQL database for tests.
# This prevents test runs and RefreshDatabase from wiping local working data
# (zones, tables, sales) used during manual QA sessions.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=techmizane_testing
DB_USERNAME=techmizane
DB_PASSWORD=secret

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

BCRYPT_ROUNDS=4
